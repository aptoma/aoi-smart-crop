{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"bracketSpacing": false,
			"arrowParentheses": "always",
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noForEach": "off"
			},
			"suspicious": {
				"noRedundantUseStrict": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["package.json"],
			"json": {
				"formatter": {
					"indentStyle": "space",
					"indentWidth": 2
				}
			}
		}
	]
}
